---
/**
 * TalkGrid — Vortragsvideos einer Ausgabe als Raster.
 * Vorschaubild wird erst beim Klick durch das YouTube-Video ersetzt (Facade, youtube-nocookie).
 */
interface Talk {
  id: string;
  title: string;
  speaker?: string;
}

interface Props {
  talks: Talk[];
  label: string;
  playlistUrl: string;
}

const { talks, label, playlistUrl } = Astro.props;
---

<div class="archive-talks-wrap">
  <div class="archive-talks__head">
    <p class="archive-talks__label">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8"/><path d="M12 3v4"/><polygon points="10 11 16 14 10 17 10 11"/></svg>
      {label}
    </p>
    <a href={playlistUrl} target="_blank" rel="noopener noreferrer" class="archive-yt-btn">
      <img src="/images/youtube.svg" alt="" class="archive-yt-icon" aria-hidden="true" />
      Ganze Playlist
    </a>
  </div>

  <ul class="archive-talks" role="list">
    {talks.map(talk => (
      <li class="talk-card">
        <button
          class="talk-card__player"
          type="button"
          data-video={talk.id}
          aria-label={`Video abspielen: ${talk.title}${talk.speaker ? ` – ${talk.speaker}` : ""}`}
        >
          <img
            src={`https://i.ytimg.com/vi/${talk.id}/hqdefault.jpg`}
            alt=""
            loading="lazy"
            width="480"
            height="270"
            class="talk-card__thumb"
          />
          <span class="talk-card__play" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </button>
        <div class="talk-card__body">
          <h3 class="talk-card__title">{talk.title}</h3>
          {talk.speaker && <p class="talk-card__speaker">{talk.speaker}</p>}
        </div>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".talk-card__player").forEach(btn => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.video;
      if (!id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute("aria-label") ?? "Video";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.loading = "lazy";
      iframe.className = "talk-card__iframe";
      btn.replaceWith(iframe);
    });
  });
</script>

<style is:global>
.archive-talks-wrap {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.archive-talks__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.archive-talks__label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text-muted);
  max-width: none;
  margin: 0;
}

.archive-yt-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.6em 2em;
  background-image: url('/images/btn-v1-black.svg');
  background-size: 100% 100%;
  background-repeat: no-repeat;
  background-color: transparent;
  border: none;
  font-family: var(--brand-font-bold);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: #fafaff;
  text-decoration: none;
}

.archive-yt-icon {
  height: 20px;
  width: auto;
}

.archive-talks {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: var(--space-6) var(--space-4);
}

.talk-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.talk-card__player {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  padding: 0;
  border: none;
  background: #26282a;
  border-radius: var(--radius-lg);
  overflow: hidden;
  cursor: pointer;
}

.talk-card__thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.talk-card__player:hover .talk-card__thumb,
.talk-card__player:focus-visible .talk-card__thumb {
  transform: scale(1.05);
  opacity: 0.85;
}

.talk-card__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: rgba(38, 40, 42, 0.82);
  color: #e5b969;
  transition: background 0.2s ease, transform 0.2s ease;
}

.talk-card__player:hover .talk-card__play {
  background: #26282a;
  transform: translate(-50%, -50%) scale(1.08);
}

.talk-card__play svg {
  margin-left: 3px;
}

.talk-card__player:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

.talk-card__iframe {
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 0;
  border-radius: var(--radius-lg);
  display: block;
}

.talk-card__title {
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  line-height: 1.3;
  margin: 0;
  color: #26282a;
}

.talk-card__speaker {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin: 0;
  max-width: none;
}
</style>
