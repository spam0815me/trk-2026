---
import PageLayout from "../../layouts/PageLayout.astro";
import { useTranslations } from "../../lib/i18n";

const locale = "de";
const t = useTranslations(locale);
const site = Astro.site?.toString() ?? "https://tierrechtskongress.ch";

const editions = [
  {
    year: "2026",
    href: "/archiv/2026",
    image: "/images/archiv/2026/trk26-bericht.webp",
    meta: "23.–25. Oktober 2026 · Photobastei Zürich",
    text: "Bericht und Aufzeichnungen der Vorträge.",
  },
  {
    year: "2023",
    href: "/archiv/2023",
    image: "/images/gallery-2023/tierrechtskongress-2023_52909463664_l.jpg",
    meta: "Erster Kongress · Photobastei Zürich",
    text: "Aufzeichnungen der Vorträge und Fotos.",
  },
];
---

<PageLayout
  title={t("archive.title")}
  description={t("archive.lead")}
  locale={locale}
  canonicalUrl={`${site}archiv/`}
  alternates={{ de: `${site}archiv/`, en: `${site}en/archive/` }}
  breadcrumbs={[{ label: t("archive.title") }]}
>
  <div class="section">
    <header class="section__header">
      <h1 class="section__title">{t("archive.title")}</h1>
      <p class="section__lead">{t("archive.lead")} Wähle ein Jahr.</p>
    </header>

    <ul class="edition-list" role="list">
      {editions.map(e => (
        <li>
          <a href={e.href} class="edition-card">
            <img src={e.image} alt="" loading="lazy" class="edition-card__img" />
            <span class="edition-card__body">
              <span class="edition-card__year">Tierrechtskongress {e.year}</span>
              <span class="edition-card__meta">{e.meta}</span>
              <span class="edition-card__text">{e.text}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</PageLayout>

<style>
.edition-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-6);
}

.edition-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: #26282a;
  color: #fafaff;
  text-decoration: none;
  transition: transform 0.2s ease;
}

.edition-card:hover,
.edition-card:focus-visible {
  transform: translateY(-4px);
}

.edition-card:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 3px;
}

.edition-card__img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  display: block;
}

.edition-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-5) var(--space-6) var(--space-6);
}

.edition-card__year {
  font-family: var(--brand-font-bold);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: #e5b969;
}

.edition-card__meta {
  font-size: var(--text-sm);
  opacity: 0.8;
}
</style>
