---
import PageLayout from "../../layouts/PageLayout.astro";
import SessionCard from "../../components/program/SessionCard.astro";
import { useTranslations, getField } from "../../lib/i18n";
import { getCollection } from "astro:content";
import { getCurrentSessions, toSessionView } from "../../lib/sessions";

const locale = "de";
const t = useTranslations(locale);

const site = Astro.site?.toString() ?? "https://tierrechtskongress.ch";
const canonicalUrl = `${site}programm/merkliste/`;
const alternates = {
  de: canonicalUrl,
  en: `${site}en/program/bookmarks/`,
};

const sessions = await getCurrentSessions(2026);
const rooms    = await getCollection("rooms");
const speakers = await getCollection("speakers");

const roomMap    = Object.fromEntries(rooms.map(r => [r.data.id, r]));
const speakerMap = Object.fromEntries(speakers.map(s => [s.data.id, s]));

const sessionViews = sessions
  .map(s => ({
    view: toSessionView(s, locale),
    roomName: getField<string>("name", locale, roomMap[s.data.roomId]?.data as unknown as Record<string, unknown> ?? {}),
    speakerNames: s.data.speakerIds.map(id => speakerMap[id]?.data.name ?? ""),
    speakerPhotos: s.data.speakerIds.map(id => speakerMap[id]?.data.photo ?? ""),
    speakerSlugs: s.data.speakerIds.map(id => speakerMap[id]?.data.slug ?? ""),
  }))
  .sort((a, b) => {
    if (a.view.day !== b.view.day) return a.view.day - b.view.day;
    return a.view.startTime.localeCompare(b.view.startTime);
  });

// Nach Tag und Raum gruppieren
const dayLabels: Record<number, string> = { 1: "Freitag", 2: "Samstag", 3: "Sonntag" };

const roomIds = ["saal-a", "saal-b"];
const roomIcons: Record<string, string> = {
  "saal-a": "/images/Icon_Sandra.svg",
  "saal-b": "/images/Icon_Yvonne.svg",
};

function formatDayFull(dateStr: string) {
  const d = new Date(dateStr + "T00:00:00");
  return d.toLocaleDateString("de-CH", { day: "numeric", month: "long", year: "numeric" });
}

const days = [...new Set(sessionViews.map(sv => sv.view.day))];
const grouped = days.map(day => ({
  day,
  label: dayLabels[day] ?? `Tag ${day}`,
  date: sessionViews.find(sv => sv.view.day === day)?.view.date ?? "",
  rooms: roomIds.map(roomId => ({
    roomId,
    icon: roomIcons[roomId],
    sessions: sessionViews.filter(sv => sv.view.day === day && sv.view.roomId === roomId),
  })),
}));
---

<PageLayout
  title={t("bookmarks.title")}
  description="Deine gemerkten Sessions auf einen Blick."
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  breadcrumbs={[
    { label: t("program.title"), href: "/programm/" },
    { label: t("bookmarks.title") },
  ]}
>
  <!-- Schwebendes Tages-Inhaltsverzeichnis (Scrollspy), wie in /programm.
       Sichtbarkeit wird per JS mit den gemerkten Tagen synchronisiert. -->
  <nav class="program-toc" aria-label="Tage" id="bm-toc" hidden>
    <ul>
      {grouped.map(({ day, date }) => {
        const d = new Date(date + "T00:00:00");
        const weekday = d.toLocaleDateString("de-CH", { weekday: "long" });
        const dm = d.toLocaleDateString("de-CH", { day: "numeric", month: "long" });
        return (
          <li data-toc-li={day} hidden>
            <a href={`#day-heading-${day}`} class="program-toc__link" data-toc-day={day}>
              <span class="program-toc__weekday">{weekday}</span>
              <span class="program-toc__date">{dm}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="container">
    <header class="bm-header">
      <h1 class="section__title">{t("bookmarks.title")}</h1>
      <div class="bm-meta">
        <p class="program-count" aria-live="polite" aria-atomic="true">
          <span id="count-num">0</span> Sessions gemerkt
        </p>
        <a href="/programm/" class="btn btn--secondary btn--sm">{t("bookmarks.goToProgram")}</a>
      </div>
    </header>

    <div class="calendar-actions" id="calendar-actions" hidden>
      <button id="cal-download" class="btn btn--primary btn--sm" type="button">
        <span class="btn-icon" style="--icon-url: url('/images/calendar.svg'); width: 18px; height: 18px;" aria-hidden="true"></span>
        {t("bookmarks.addToCalendar")}
      </button>
    </div>

    <div class="bm-list" id="bm-list">
      {grouped.map(({ day, label, date, rooms }) => (
        <section class="bm-day" data-day={day} aria-labelledby={`day-heading-${day}`} hidden>
          <h2 class="bm-day__heading" id={`day-heading-${day}`}>
            {label}
            <span class="bm-day__date">{formatDayFull(date)}</span>
          </h2>
          <div class="bm-day__rooms">
            {rooms.map(({ roomId, icon, sessions: roomSessions }) => (
              <div class="bm-room" data-room={roomId}>
                <div class="bm-room__header">
                  {icon && <img src={icon} alt={roomId} class="bm-room__icon" />}
                </div>
                <div class="bm-room__sessions">
                  {roomSessions.map(({ view, roomName, speakerNames, speakerPhotos, speakerSlugs }) => (
                    <div class="bookmark-item" data-session-id={view.id} hidden>
                      <div class="bm-time">{view.startTime} – {view.endTime}</div>
                      <SessionCard
                        id={view.id}
                        slug={view.slug}
                        title={view.title}
                        description={view.description}
                        type={view.type}
                        language={view.language}
                        startTime={view.startTime}
                        endTime={view.endTime}
                        durationMinutes={view.durationMinutes}
                        day={view.day}
                        date={view.date}
                        roomName={roomName}
                        roomId={view.roomId}
                        speakerNames={speakerNames}
                        speakerPhotos={speakerPhotos}
                        speakerSlugs={speakerSlugs}
                        locale={locale}
                        registrationRequired={view.registrationRequired}
                        recording={view.recording}
                        status={view.status}
                      />
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div id="empty-state" class="bookmarks-empty" hidden>
        <p><strong>{t("bookmarks.empty")}</strong></p>
        <p>{t("bookmarks.emptyHint")}</p>
        <a href="/programm/" class="btn btn--primary" style="margin-top: var(--space-4);">{t("bookmarks.goToProgram")}</a>
      </div>
    </div>
  </div>
</PageLayout>

<script is:inline define:vars={{ trkSessions: sessionViews.map(sv => ({
    uid: sv.view.id,
    title: sv.view.title,
    description: sv.view.description,
    startDate: sv.view.date,
    startTime: sv.view.startTime,
    endTime: sv.view.endTime,
    location: sv.roomName,
    url: `https://tierrechtskongress.ch/programm/${sv.view.slug}/`,
  })) }}>
  window.__TRK_SESSIONS__ = trkSessions;
</script>

<script src="../../scripts/bookmarks.js"></script>
<script src="../../scripts/calendar-export.js"></script>
<script>
  const STORAGE_KEY = "trk2026_bookmarks";

  function getBookmarks() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]"); }
    catch { return []; }
  }

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".program-toc__link")];
  const daySections = [...document.querySelectorAll<HTMLElement>(".bm-day")];

  // Aktiven TOC-Link sicherstellen (erster sichtbarer Tag), falls keiner aktiv ist
  function syncActiveTocLink() {
    const visible = tocLinks.filter(l => !l.closest("li")?.hasAttribute("hidden"));
    if (visible.length && !visible.some(l => l.classList.contains("is-active"))) {
      tocLinks.forEach(l => l.classList.remove("is-active"));
      visible[0].classList.add("is-active");
    }
  }

  function render() {
    const ids = getBookmarks();
    let totalCount = 0;
    const visibleDays = new Set<string>();

    document.querySelectorAll(".bm-day").forEach(dayEl => {
      let dayCount = 0;

      // Raumspalten prüfen
      dayEl.querySelectorAll<HTMLElement>(".bm-room").forEach(roomEl => {
        const items = roomEl.querySelectorAll<HTMLElement>(".bookmark-item[data-session-id]");
        let roomCount = 0;
        items.forEach(item => {
          const visible = ids.includes(item.dataset.sessionId ?? "");
          item.hidden = !visible;
          if (visible) { roomCount++; dayCount++; totalCount++; }
        });
        roomEl.hidden = roomCount === 0;
      });

      (dayEl as HTMLElement).hidden = dayCount === 0;
      if (dayCount > 0) visibleDays.add(dayEl.getAttribute("data-day") ?? "");
    });

    const countEl = document.getElementById("count-num");
    if (countEl) countEl.textContent = String(totalCount);

    const empty = document.getElementById("empty-state");
    if (empty) empty.hidden = totalCount > 0;

    // Inhaltsverzeichnis mit sichtbaren Tagen synchronisieren
    let anyTocVisible = false;
    document.querySelectorAll<HTMLElement>("[data-toc-li]").forEach(li => {
      const show = visibleDays.has(li.getAttribute("data-toc-li") ?? "");
      li.hidden = !show;
      if (show) anyTocVisible = true;
    });
    const toc = document.getElementById("bm-toc");
    if (toc) toc.hidden = !anyTocVisible;
    syncActiveTocLink();
  }

  // TOC: sanftes Scrollen + Scrollspy (wie /programm)
  tocLinks.forEach(link => {
    link.addEventListener("click", e => {
      const id = link.getAttribute("href")?.slice(1) ?? "";
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      history.replaceState(null, "", "#" + id);
    });
  });

  if (daySections.length && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const day = entry.target.getAttribute("data-day");
            tocLinks.forEach((l) =>
              l.classList.toggle("is-active", l.getAttribute("data-toc-day") === day)
            );
          }
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
    );
    daySections.forEach((s) => observer.observe(s));
  }

  render();
  window.addEventListener("bookmarks-changed", render);
  window.addEventListener("storage", e => { if (e.key === STORAGE_KEY) render(); });
</script>

<style>
/* Schwebendes Tages-Inhaltsverzeichnis (Scrollspy) — wie in /programm */
.program-toc {
  display: none;
}

@media (min-width: 1240px) {
  .program-toc:not([hidden]) {
    display: block;
    position: fixed;
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
  }

  .program-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border-left: 2px solid var(--color-border);
  }

  .program-toc__link {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: var(--space-2) var(--space-4);
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .program-toc__weekday {
    font-family: var(--brand-font-bold);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.15;
  }

  .program-toc__date {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .program-toc__link:hover {
    color: var(--color-text);
  }

  .program-toc__link.is-active {
    color: var(--color-text);
    border-left-color: var(--color-primary);
  }
}

.bm-header {
  padding-top: var(--space-8);
  margin-bottom: var(--space-6);
}

.bm-meta {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

.calendar-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-8);
}

.calendar-actions[hidden] {
  display: none;
}

/* Kalender-Button randlos einfärben: Stretch-Variante nutzen. Das Standard-
   meet-SVG (btn-v2-black.svg) sitzt mittig und lässt die Seiten breiter
   Buttons ungefärbt. */
.calendar-actions .btn--primary {
  background-image: url('/images/btn-v2-black-stretch.svg');
}
.calendar-actions .btn--primary:hover {
  background-image: url('/images/btn-v2-yellow-stretch.svg');
}

.program-count {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  max-width: none;
  margin: 0;
}

.bm-list {
  margin-bottom: var(--space-12);
}

.bm-day {
  margin-bottom: var(--space-10);
}

.bm-day__heading {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  font-size: var(--text-2xl);
  margin-bottom: var(--space-5);
  padding-bottom: var(--space-3);
  border-bottom: 2px solid var(--color-primary);
}

.bm-day__date {
  font-size: var(--text-base);
  font-weight: var(--weight-normal);
  color: var(--color-text-muted);
}

.bm-day__rooms {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
}

@media (min-width: 768px) {
  .bm-day__rooms {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
}

.bm-room__header {
  margin-bottom: var(--space-3);
}

.bm-room__icon {
  height: 36px;
  width: auto;
}

.bm-room__sessions {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.bookmark-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.bookmark-item[hidden] {
  display: none !important;
}

.bm-day[hidden],
.bm-room[hidden] {
  display: none !important;
}

.bm-time {
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: var(--color-text-muted);
  padding-left: var(--space-1);
}

.bookmarks-empty {
  padding: var(--space-12);
  text-align: center;
  color: var(--color-text-muted);
}
</style>
