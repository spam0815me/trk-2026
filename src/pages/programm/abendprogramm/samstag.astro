---
/**
 * Samstagabend — Konzert «Queere Tiere» (Detailseite)
 *
 * Die Endzeit steht noch nicht fest: deshalb kein `endTime`
 * (Anzeige «ab 20:00», kein Kalender-Eintrag, kein Event-JSON-LD).
 *
 * Kurzbios und Porträts stammen wörtlich von Daniel Hellmann (Mail vom 26.8.2026).
 * Die beiden sind Auftretende des Rahmenprogramms, keine Referierenden — deshalb
 * kein Eintrag in der Speaker-Collection und kein eigenes Profil.
 */
import EveningDetail from "../../../components/programm/EveningDetail.astro";

const site = Astro.site?.toString() ?? "https://tierrechtskongress.ch";
const canonicalUrl = `${site}programm/abendprogramm/samstag/`;

const description =
  "Samstagabend am TRK 2026: «Queere Tiere» – Konzert von Soya the Cow & Piano Prince über schwule Schwäne, zweigeschlechtliche Regenwürmer und die Vielfalt im Tierreich.";

const people = [
  {
    name: "Daniel Hellmann",
    role: "Performancekünstler, Sänger und Aktivist",
    bio: "Daniel Hellmann ist Performancekünstler, Sänger und Aktivist aus Zürich. Er schafft interdisziplinäre, künstlerische Arbeiten an der Schnittstelle von Tanz, Sprache und Musik. Seine Projekte befragen Machtverhältnisse, Körperpolitiken und Begehren. Seit 2018 tritt er mit seinem Alter Ego auf, der veganen, queeren Dragfigur Soya the Cow. 2025 wurde Daniel Hellmann mit dem Schweizer Preis Darstellende Künste ausgezeichnet.",
    photo: "/images/abendprogramm/daniel-hellmann.webp",
    photoAlt: "Porträt von Daniel Hellmann vor türkisfarbenem Hintergrund, blond gefärbte Haare, Pullover in Weiss, Rot und Schwarz.",
    photoCredit: "Foto: Charlotte Krieger",
    website: "https://daniel-hellmann.com",
  },
  {
    name: "Coco Schwarz",
    role: "Pianist*in, DJ und Klangkünstler*in",
    bio: "Coco Schwarz ist Pianist*in, DJ und Klangkünstler*in aus Zürich. Die künstlerische Arbeit bewegt sich zwischen Alter Musik auf Hammerklavier und Cembalo und experimenteller elektronischer Klangwelt – von Modularsynthesizer bis Feldaufnahmen. Daneben entstehen Videoarbeiten und Ausstellungsformate, in denen Klang, Bild und Raum ineinandergreifen. 2023/24 erhielt Coco die Auszeichnung eines Werkjahrs des Kantons Graubünden.",
    photo: "/images/abendprogramm/coco-schwarz.webp",
    photoAlt: "Porträt von Coco Schwarz mit runder Sonnenbrille und gestreiftem Shirt, das Bild in schillernde Regenbogenfarben verfremdet.",
    website: "https://coco-schwarz.ch",
  },
];
---

<EveningDetail
  title="Queere Tiere"
  subtitle="Konzert von Soya the Cow & Piano Prince."
  description={description}
  dayLabel="Samstag, 24. Oktober"
  date="2026-10-24"
  startTime="20:00"
  canonicalUrl={canonicalUrl}
  slug="queere-tiere"
  roomName="Raum Sandra"
  roomIcon="/images/Raum_Sandra.svg"
  image="/images/abendprogramm/queere-tiere.webp"
  imageAlt="Soya the Cow und Piano Prince in schillernden Tierkostümen vor einem grossen Mond, der sich im Wasser spiegelt."
  imageWidth={914}
  imageHeight={1280}
  imageCredit="Foto: Olivia Schenker"
  note="Ohne Anmeldung."
  people={people}
>
  <p>
    In einem schillernd-faszinierenden Liederabend erzählen Daniel Hellmann und Coco Schwarz als ihre
    Kunstfiguren <strong>Soya the Cow</strong> und <strong>Piano Prince</strong> von schwulen
    Schwänen, zweigeschlechtlichen Regenwürmern und der Vielfalt von Sexualitäten, Liebes- und
    Lebensformen im Tierreich. Eine charmante, subversive Mischung aus Drag Show, queerer
    Biologiestunde und virtuoser Musik-Gala.
  </p>
  <p>
    Mehr zu den beiden:
    <a href="https://www.soyathecow.com" target="_blank" rel="noopener noreferrer">soyathecow.com</a>
    und <a href="https://mx3.ch/pianoprince" target="_blank" rel="noopener noreferrer">mx3.ch/pianoprince</a>,
    auf Instagram <a href="https://www.instagram.com/soyathecow/" target="_blank" rel="noopener noreferrer">@soyathecow</a>
    und <a href="https://www.instagram.com/pianoprince_music/" target="_blank" rel="noopener noreferrer">@pianoprince_music</a>.
  </p>
</EveningDetail>
